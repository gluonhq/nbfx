<?xml-stylesheet type="text/xsl" href="../../nbbuild/javadoctools/apichanges.xsl"?>
<!DOCTYPE apichanges PUBLIC "-//NetBeans//DTD API changes list 1.0//EN" "../../nbbuild/javadoctools/apichanges.dtd">
<apichanges>
    <apidefs>
        <apidef name="netbeansfx_diff">NetBeansFX Diff API</apidef>
    </apidefs>
    <changes>
        <change id="diff.unified">
            <api name="netbeansfx_diff"/>
            <summary>The unified text of a comparison.</summary>
            <version major="1" minor="1"/>
            <date day="28" month="11" year="2026"/>
            <author login="jperedadnr"/>
            <compatibility addition="yes" semantic="compatible"/>
            <description>
                Adds <code>UnifiedDiff</code>, which writes the differences between two texts as
                <code>diff -u</code> does: the two names, then each hunk with its
                <code>@@</code> ranges, its lines of context and
                <code>\ No newline at end of file</code> where a text ends without one - a last
                line that only one of the texts ends is written as a line that differs. The names
                are quoted as <code>git diff</code> quotes paths, so that each is one line. It
                also tells the line each block of differences starts at in that text.
            </description>
            <class package="org.netbeans.api.nbfx.diff" name="UnifiedDiff"/>
        </change>
        <change id="diff.lines">
            <api name="netbeansfx_diff"/>
            <summary>The headless line comparison.</summary>
            <version major="1" minor="0"/>
            <date day="27" month="11" year="2026"/>
            <author login="jperedadnr"/>
            <compatibility addition="yes" semantic="compatible"/>
            <description>
                Adds <code>Diff</code>, which compares two texts line by line, its
                <code>DiffOptions</code>, and the <code>DiffResult</code> it answers with: the
                <code>Difference</code> blocks of added, deleted and changed lines. A comparison
                can be cancelled, before it starts and in every loop of it; the options leave
                out, together, what each leaves out, and letters are compared whatever their
                case one for one. A result checks that its blocks are in order.
            </description>
            <class package="org.netbeans.api.nbfx.diff" name="Diff"/>
            <class package="org.netbeans.api.nbfx.diff" name="DiffOptions"/>
            <class package="org.netbeans.api.nbfx.diff" name="DiffResult"/>
            <class package="org.netbeans.api.nbfx.diff" name="Difference"/>
        </change>
    </changes>
    <htmlcontents>
        <head>
            <title>Change History for the NetBeansFX Diff API</title>
        </head>
        <body>
            <p class="overviewlink"><a href="overview-summary.html">Overview</a></p>
            <h1>Introduction</h1>
            <p>This document lists changes made to the <a href="@TOP@">NetBeansFX Diff API</a>.</p>
            <hr/><standard-changelists module-code-name="org.netbeans.modules.nbfx.api.diff"/>
            <hr/><p>@FOOTER@</p>
        </body>
    </htmlcontents>
</apichanges>
