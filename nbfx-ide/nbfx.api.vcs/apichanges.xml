<?xml-stylesheet type="text/xsl" href="../../nbbuild/javadoctools/apichanges.xsl"?>
<!DOCTYPE apichanges PUBLIC "-//NetBeans//DTD API changes list 1.0//EN" "../../nbbuild/javadoctools/apichanges.dtd">
<apichanges>
    <apidefs>
        <apidef name="netbeansfx_vcs">NetBeansFX VCS API</apidef>
    </apidefs>
    <changes>
        <change id="vcs.annotator">
            <api name="netbeansfx_vcs"/>
            <summary>The file state annotator contract.</summary>
            <version major="1" minor="0"/>
            <date day="26" month="11" year="2026"/>
            <author login="jperedadnr"/>
            <compatibility addition="yes" semantic="compatible"/>
            <description>
                Adds <code>VcsAnnotator</code>, which a version control system registers in the
                default lookup to tell the views that draw files the state of each and of the
                changed files a folder holds, and the <code>VcsFileState</code> enum of the states
                a view tells apart.
            </description>
            <class package="org.netbeans.api.nbfx.vcs" name="VcsAnnotator"/>
            <class package="org.netbeans.api.nbfx.vcs" name="VcsFileState"/>
        </change>
    </changes>
    <htmlcontents>
        <head>
            <title>Change History for the NetBeansFX VCS API</title>
        </head>
        <body>
            <p class="overviewlink"><a href="overview-summary.html">Overview</a></p>
            <h1>Introduction</h1>
            <p>This document lists changes made to the <a href="@TOP@">NetBeansFX VCS API</a>.</p>
            <hr/><standard-changelists module-code-name="org.netbeans.modules.nbfx.api.vcs"/>
            <hr/><p>@FOOTER@</p>
        </body>
    </htmlcontents>
</apichanges>
