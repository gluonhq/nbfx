<?xml-stylesheet type="text/xml" href="../../nbbuild/javadoctools/apichanges.xsl"?>
<!DOCTYPE apichanges PUBLIC "-//NetBeans//DTD API changes list 1.0//EN" "../../nbbuild/javadoctools/apichanges.dtd">
<apichanges>
    <apidefs>
        <apidef name="netbeansfx_project">NetBeansFX Project API</apidef>
    </apidefs>
    <changes>
        <change id="project.opener.dialog">
            <api name="netbeansfx_project"/>
            <summary>ProjectOpener owns the open-project dialog.</summary>
            <version major="1" minor="2"/>
            <date day="4" month="11" year="2026"/>
            <author login="sven"/>
            <compatibility addition="yes" semantic="compatible"/>
            <description>
                Adds <code>ProjectOpener.open()</code> so the IDE implementation owns the
                directory chooser and its owner window; <code>open(FileObject)</code> remains the
                root-based operation.
            </description>
            <class package="org.netbeans.api.nbfx.project" name="ProjectOpener"/>
        </change>
        <change id="project.lifecycle">
            <api name="netbeansfx_project"/>
            <summary>Project lifecycle and opener contracts.</summary>
            <version major="1" minor="1"/>
            <date day="4" month="11" year="2026"/>
            <author login="sven"/>
            <compatibility addition="yes" semantic="compatible"/>
            <description>
                Documents the split between <code>ProjectLifecycle</code> for close/select and
                <code>ProjectOpener</code> for opening a project by root.
            </description>
            <class package="org.netbeans.api.nbfx.project" name="ProjectLifecycle"/>
            <class package="org.netbeans.api.nbfx.project" name="ProjectOpener"/>
        </change>
    </changes>
    <htmlcontents>
        <head>
            <title>Change History for the NetBeansFX Project API</title>
        </head>
        <body>
            <p class="overviewlink"><a href="overview-summary.html">Overview</a></p>
            <h1>Introduction</h1>
            <p>This document lists changes made to the <a href="@TOP@">NetBeansFX Project API</a>.</p>
            <hr/><standard-changelists module-code-name="org.netbeans.modules.nbfx.api.project"/>
            <hr/><p>@FOOTER@</p>
        </body>
    </htmlcontents>
</apichanges>
