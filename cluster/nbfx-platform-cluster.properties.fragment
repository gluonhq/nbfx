# =============================================================================
# nbfx platform-only deliverable (the AppShell, without the IDE or Java clusters)
#
# Use with:
#   ant platform-build
# or explicitly:
#   ant bootstrap build \
#       -Dnbfx.cluster.config=nbfx-platform \
#       -Dnbfx.fragment.file=cluster/nbfx-platform-cluster.properties.fragment \
#       -Dnbfx.cluster.properties=build/cluster-platform.properties
#
# The upstream ide cluster is required by platform.editor's lexer modules; it is not the nbfx
# IDE building blocks. `check-platform-delivery` asserts that no nb.cluster.nbfx-ide or
# nb.cluster.nbfx-java module is selected.
# =============================================================================

clusters.config.nbfx-platform.list=\
        nb.cluster.platform,\
        nb.cluster.nbfx-libs,\
        nb.cluster.nbfx-platform,\
        nb.cluster.ide
