<?xml-stylesheet type="text/xml" href="../../nbbuild/javadoctools/apichanges.xsl"?>
<!DOCTYPE apichanges PUBLIC "-//NetBeans//DTD API changes list 1.0//EN" "../../nbbuild/javadoctools/apichanges.dtd">
<apichanges>
    <apidefs>
        <apidef name="netbeansfx_theme">NetBeansFX Theme API</apidef>
    </apidefs>
    <changes>
        <change id="theme.initial">
            <api name="netbeansfx_theme"/>
            <summary>Initial theme and CSS token provider API.</summary>
            <version major="1" minor="0"/>
            <date day="4" month="11" year="2026"/>
            <author login="sven"/>
            <compatibility addition="yes" semantic="compatible"/>
            <description>
                Introduces <code>ThemeToken</code>, <code>ThemeTokenProvider</code>,
                <code>@ThemeTokenRegistration</code>, <code>ThemeTokenType</code>,
                <code>ThemeMode</code> and the <code>ThemeTokenRegistry</code> that resolves the
                registered stylesheets. Component token defaults are CSS resources applied before
                the selected theme; the platform defaults live in the theme module and every
                referenced <code>-nbfx-*</code> token has a default there. Bundled themes are
                loaded from the module resources, and the <code>nbfx-themes</code> user folder is
                an optional overlay. <code>NbfxTheme</code> is the public entry point for mode
                selection, applying the theme to scenes and dialog panes, and listing themes. The
                initial values and bundled themes come from PR #83 by Geertjan Wielenga
                (@geertjanw).
            </description>
            <class package="org.netbeans.api.nbfx.theme" name="ThemeMode"/>
            <class package="org.netbeans.api.nbfx.theme" name="ThemeToken"/>
            <class package="org.netbeans.api.nbfx.theme" name="ThemeTokenProvider"/>
            <class package="org.netbeans.api.nbfx.theme" name="ThemeTokenRegistration"/>
            <class package="org.netbeans.api.nbfx.theme" name="ThemeTokenRegistrations"/>
            <class package="org.netbeans.api.nbfx.theme" name="ThemeTokenType"/>
            <class package="org.netbeans.modules.nbfx.platform.theme" name="NbfxTheme"/>
            <class package="org.netbeans.modules.nbfx.platform.theme" name="ThemeTokenRegistry"/>
        </change>
    </changes>
    <htmlcontents>
        <head>
            <title>Change History for the NetBeansFX Theme API</title>
        </head>
        <body>
            <p class="overviewlink"><a href="overview-summary.html">Overview</a></p>
            <h1>Introduction</h1>
            <p>This document lists changes made to the <a href="@TOP@">NetBeansFX Theme API</a>.</p>
            <hr/><standard-changelists module-code-name="org.netbeans.modules.nbfx.platform.theme"/>
            <hr/><p>@FOOTER@</p>
        </body>
    </htmlcontents>
</apichanges>
