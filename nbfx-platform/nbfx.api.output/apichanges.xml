<?xml-stylesheet type="text/xml" href="../../nbbuild/javadoctools/apichanges.xsl"?>
<!DOCTYPE apichanges PUBLIC "-//NetBeans//DTD API changes list 1.0//EN" "../../nbbuild/javadoctools/apichanges.dtd">
<apichanges>
    <apidefs>
        <apidef name="netbeansfx_output">NetBeansFX Output API</apidef>
    </apidefs>
    <changes>
        <change id="output.api">
            <api name="netbeansfx_output"/>
            <summary>The output console contract, out of the Output window's module.</summary>
            <version major="1" minor="0"/>
            <date day="19" month="11" year="2026"/>
            <author login="jpereda"/>
            <compatibility addition="yes" semantic="compatible"/>
            <description>
                <code>OutputConsole</code> and <code>ConsolePanel</code> move here from
                <code>platform.output</code>, which no longer publishes a package. Asking for a
                console no longer opens the Output window: <code>ConsolePanel.show()</code> does.
                A console can be asked for by an id apart from the name on its tab, with
                <code>OutputConsole.console(String, String)</code>.
                A console learns how to run its activity again with
                <code>ConsolePanel.setRerun(Runnable)</code>, and that one is running, and how to
                stop it, with <code>ConsolePanel.startRun(Runnable)</code>, whose
                <code>ConsoleRun</code> ends that run and no other.
            </description>
            <class package="org.netbeans.api.nbfx.output" name="OutputConsole"/>
            <class package="org.netbeans.api.nbfx.output" name="ConsolePanel"/>
            <class package="org.netbeans.api.nbfx.output" name="ConsoleRun"/>
        </change>
    </changes>
    <htmlcontents>
        <head>
            <title>Change History for the NetBeansFX Output API</title>
        </head>
        <body>
            <p class="overviewlink"><a href="overview-summary.html">Overview</a></p>
            <h1>Introduction</h1>
            <p>This document lists changes made to the <a href="@TOP@">NetBeansFX Output API</a>.</p>
            <hr/><standard-changelists module-code-name="org.netbeans.modules.nbfx.api.output"/>
            <hr/><p>@FOOTER@</p>
        </body>
    </htmlcontents>
</apichanges>
