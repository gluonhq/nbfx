<?xml-stylesheet type="text/xsl" href="../../nbbuild/javadoctools/apichanges.xsl"?>
<!DOCTYPE apichanges PUBLIC "-//NetBeans//DTD API changes list 1.0//EN" "../../nbbuild/javadoctools/apichanges.dtd">
<apichanges>
    <apidefs>
        <apidef name="netbeansfx_content">NetBeansFX Content API</apidef>
    </apidefs>
    <changes>
        <change id="cjap.content.vocabulary">
            <api name="netbeansfx_content"/>
            <summary>Neutral content identity, kind and persisted-state vocabulary.</summary>
            <version major="1" minor="0"/>
            <date day="25" month="11" year="2026"/>
            <author login="svenreimers"/>
            <compatibility addition="yes" semantic="compatible"/>
            <description>
                Adds <code>ContentId</code>, extensible <code>ContentKind</code> and
                <code>ContentState</code>. The content factory, requirements, manager and sources
                land in the following content slices; this change is the shared vocabulary they,
                docking and drop handlers use.
            </description>
            <class package="org.netbeans.api.nbfx.content" name="ContentId"/>
            <class package="org.netbeans.api.nbfx.content" name="ContentKind"/>
            <class package="org.netbeans.api.nbfx.content" name="ContentState"/>
        </change>
        <change id="cjap.content.lifecycle">
            <api name="netbeansfx_content"/>
            <summary>Content lifecycle, factory and host requirements.</summary>
            <version major="1" minor="1"/>
            <date day="25" month="11" year="2026"/>
            <author login="svenreimers"/>
            <compatibility addition="yes" semantic="compatible"/>
            <description>
                Adds <code>Content</code>, <code>ContentFactory</code>,
                <code>ContentRequirements</code> and <code>ContentCreationException</code>. Content
                has a stable identity, node and lifecycle the manager drives; the factory recreates
                content from its state and captures it back. The content manager and sources land in
                the following content slices.
            </description>
            <class package="org.netbeans.api.nbfx.content" name="Content"/>
            <class package="org.netbeans.api.nbfx.content" name="ContentCreationException"/>
            <class package="org.netbeans.api.nbfx.content" name="ContentFactory"/>
            <class package="org.netbeans.api.nbfx.content" name="ContentRequirements"/>
        </change>
        <change id="cjap.content.manager">
            <api name="netbeansfx_content"/>
            <summary>Content lifecycle and routing seam.</summary>
            <version major="1" minor="2"/>
            <date day="25" month="11" year="2026"/>
            <author login="svenreimers"/>
            <compatibility addition="yes" semantic="compatible"/>
            <description>
                Adds <code>ContentManager</code>: open, close, find, the open snapshot and the
                observable active content. The manager owns close/dispose; opening from a content
                source is added with the sources slice. The platform implementation follows.
            </description>
            <class package="org.netbeans.api.nbfx.content" name="ContentManager"/>
        </change>
    </changes>
    <htmlcontents>
        <head>
            <title>Change History for the NetBeansFX Content API</title>
        </head>
        <body>
            <p class="overviewlink"><a href="overview-summary.html">Overview</a></p>
            <h1>Introduction</h1>
            <p>This document lists changes made to the <a href="@TOP@">NetBeansFX Content API</a>.</p>
            <hr/><standard-changelists module-code-name="org.netbeans.modules.nbfx.api.content"/>
            <hr/><p>@FOOTER@</p>
        </body>
    </htmlcontents>
</apichanges>