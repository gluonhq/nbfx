<?xml-stylesheet type="text/xml" href="../../nbbuild/javadoctools/apichanges.xsl"?>
<!DOCTYPE apichanges PUBLIC "-//NetBeans//DTD API changes list 1.0//EN" "../../nbbuild/javadoctools/apichanges.dtd">
<apichanges>
    <apidefs>
        <apidef name="netbeansfx_shell">NetBeansFX Shell API</apidef>
    </apidefs>
    <changes>
        <change id="shell.pane.spi">
            <api name="netbeansfx_shell"/>
            <summary>Pane provider SPI and declarative pane composition.</summary>
            <version major="1" minor="4"/>
            <date day="4" month="11" year="2026"/>
            <author login="sven"/>
            <compatibility addition="yes" semantic="compatible"/>
            <description>
                Introduces the <code>org.netbeans.modules.nbfx.platform.shell.spi</code> package:
                <code>WindowPane</code>, <code>WindowPaneProvider</code> and
                <code>WindowPaneContext</code>. Providers supply concrete panes for declarative
                registrations and may release their resources when the shell stops. The shell
                resolves providers from its lookup and owns their pane lifecycle.
            </description>
            <class package="org.netbeans.modules.nbfx.platform.shell.spi" name="WindowPane"/>
            <class package="org.netbeans.modules.nbfx.platform.shell.spi" name="WindowPaneProvider"/>
            <class package="org.netbeans.modules.nbfx.platform.shell.spi" name="WindowPaneContext"/>
        </change>
        <change id="window.environment.capabilities">
            <api name="netbeansfx_shell"/>
            <summary>Focused window environment capabilities.</summary>
            <version major="1" minor="5"/>
            <date day="4" month="11" year="2026"/>
            <author login="sven"/>
            <compatibility addition="yes" deprecation="yes" semantic="compatible"/>
            <description>
                Adds <code>DetachedBarsProvider</code>, <code>TabHomeResolver</code>,
                <code>ProjectSwitcher</code> and <code>NavigatorRevealState</code>, composes them
                independently, and deprecates the broad <code>WindowEnvironmentContribution</code>
                as the compatibility fallback.
            </description>
            <class package="org.netbeans.modules.nbfx.platform.shell.api" name="DetachedBarsProvider"/>
            <class package="org.netbeans.modules.nbfx.platform.shell.api" name="TabHomeResolver"/>
            <class package="org.netbeans.modules.nbfx.platform.shell.api" name="ProjectSwitcher"/>
            <class package="org.netbeans.modules.nbfx.platform.shell.api" name="NavigatorRevealState"/>
            <class package="org.netbeans.modules.nbfx.platform.shell.api" name="WindowEnvironmentContribution"/>
        </change>
    </changes>
    <htmlcontents>
        <head>
            <title>Change History for the NetBeansFX Shell API</title>
        </head>
        <body>
            <p class="overviewlink"><a href="overview-summary.html">Overview</a></p>
            <h1>Introduction</h1>
            <p>This document lists changes made to the <a href="@TOP@">NetBeansFX Shell API</a>.</p>
            <hr/><standard-changelists module-code-name="org.netbeans.modules.nbfx.platform.shell"/>
            <hr/><p>@FOOTER@</p>
        </body>
    </htmlcontents>
</apichanges>
