<?xml-stylesheet type="text/xml" href="../../nbbuild/javadoctools/apichanges.xsl"?>
<!DOCTYPE apichanges PUBLIC "-//NetBeans//DTD API changes list 1.0//EN" "../../nbbuild/javadoctools/apichanges.dtd">
<apichanges>
    <apidefs>
        <apidef name="netbeansfx_shell">NetBeansFX Shell API</apidef>
    </apidefs>
    <changes>
        <change id="shell.pane.spi">
            <api name="netbeansfx_shell"/>
            <summary>Pane provider SPI and declarative pane composition.</summary>
            <version major="1" minor="4"/>
            <date day="4" month="11" year="2026"/>
            <author login="sven"/>
            <compatibility addition="yes" semantic="compatible"/>
            <description>
                Introduces the <code>org.netbeans.modules.nbfx.platform.shell.spi</code> package:
                <code>WindowPane</code>, <code>WindowPaneProvider</code> and
                <code>WindowPaneContext</code>. Providers supply concrete panes for declarative
                registrations and may release their resources when the shell stops. The shell
                resolves providers from its lookup and owns their pane lifecycle.
            </description>
            <class package="org.netbeans.modules.nbfx.platform.shell.spi" name="WindowPane"/>
            <class package="org.netbeans.modules.nbfx.platform.shell.spi" name="WindowPaneProvider"/>
            <class package="org.netbeans.modules.nbfx.platform.shell.spi" name="WindowPaneContext"/>
        </change>
        <change id="window.environment.capabilities">
            <api name="netbeansfx_shell"/>
            <summary>Focused window environment capabilities.</summary>
            <version major="1" minor="5"/>
            <date day="4" month="11" year="2026"/>
            <author login="sven"/>
            <compatibility addition="yes" deprecation="yes" semantic="compatible"/>
            <description>
                Adds <code>DetachedBarsProvider</code>, <code>TabHomeResolver</code>,
                <code>ProjectSwitcher</code> and <code>NavigatorRevealState</code>, composes them
                independently, and deprecates the broad <code>WindowEnvironmentContribution</code>
                as the compatibility fallback.
            </description>
            <class package="org.netbeans.modules.nbfx.platform.shell.api" name="DetachedBarsProvider"/>
            <class package="org.netbeans.modules.nbfx.platform.shell.api" name="TabHomeResolver"/>
            <class package="org.netbeans.modules.nbfx.platform.shell.api" name="ProjectSwitcher"/>
            <class package="org.netbeans.modules.nbfx.platform.shell.api" name="NavigatorRevealState"/>
            <class package="org.netbeans.modules.nbfx.platform.shell.api" name="WindowEnvironmentContribution"/>
        </change>
        <change id="shell.upstream.lifecycle">
            <api name="netbeansfx_shell"/>
            <summary>Declarative upstream lifecycle and appearance.</summary>
            <version major="1" minor="6"/>
            <date day="4" month="11" year="2026"/>
            <author login="sven"/>
            <compatibility addition="yes" semantic="compatible"/>
            <description>
                Adds <code>ShellWindowProvider</code> and <code>ShellContext.window()</code> so
                global services can reach the running shell, adds the nbfx
                <code>@OnUiReady</code> named-service annotation on the <code>NbFx/UIReady</code>
                path, and extends <code>ShellBranding</code> with icons, minimum size, root style
                classes and scene stylesheets. The <code>preferFile</code> overloads of
                <code>ShellContext.command</code> and <code>ShellCommandResolver.resolve</code> are
                deprecated; file-preference dispatch belongs to the resolver's command set.
            </description>
            <class package="org.netbeans.modules.nbfx.platform.shell.api" name="ShellWindowProvider"/>
            <class package="org.netbeans.modules.nbfx.platform.shell.api" name="OnUiReady"/>
            <class package="org.netbeans.modules.nbfx.platform.shell.api" name="ShellBranding"/>
            <class package="org.netbeans.modules.nbfx.platform.shell.api" name="ShellContext"/>
            <class package="org.netbeans.modules.nbfx.platform.shell.api" name="ShellCommandResolver"/>
        </change>
        <change id="branding.empty.editor.text">
            <api name="netbeansfx_shell"/>
            <summary>Product-defined empty editor text.</summary>
        <change id="platform.global.context">
            <api name="netbeansfx_shell"/>
            <summary>Platform-level global action context.</summary>
            <version major="1" minor="7"/>
            <date day="9" month="11" year="2026"/>
            <author login="sven"/>
            <compatibility addition="yes" semantic="compatible"/>
            <description>
<<<<<<< HEAD
                Adds <code>ShellBranding.emptyEditorText()</code> so a product can replace the
                platform's empty-editor placeholder with text that matches its own views. The
                default returns <code>null</code>, which keeps the platform wording.
            </description>
            <class package="org.netbeans.modules.nbfx.platform.shell.api" name="ShellBranding"/>
=======
                Moves <code>NbfxGlobalContextProvider</code> into the platform shell and publishes
                the focused pane's active editor or view to <code>ActiveComponentContext</code>.
                A product that runs the platform-only cluster now gets a JavaFX-backed
                <code>Utilities.actionsGlobalContext()</code>; follower views keep the last
                selection-bearing component.
            </description>
            <class package="org.netbeans.modules.nbfx.platform.shell" name="NbfxGlobalContextProvider"/>
        </change>
        <change id="shutdown.contract">
            <api name="netbeansfx_shell"/>
            <summary>Generic shutdown impact and confirmation contract.</summary>
            <version major="1" minor="7"/>
            <date day="9" month="11" year="2026"/>
            <author login="sven"/>
            <compatibility addition="yes" semantic="compatible"/>
            <description>
                Adds the <code>org.netbeans.modules.nbfx.platform.shell.api.shutdown</code>
                package: <code>ShutdownImpact</code>, <code>ShutdownSelection</code>,
                <code>ShutdownParticipant</code> and <code>ShutdownCoordinator</code>. The shell
                collects impact from registered participants, shows a generic confirmation dialog
                and runs the selected cleanup before exit. Products supply their own participants
                and choices; the platform contains no product-specific types.
            </description>
            <class package="org.netbeans.modules.nbfx.platform.shell.api.shutdown" name="ShutdownCoordinator"/>
            <class package="org.netbeans.modules.nbfx.platform.shell.api.shutdown" name="ShutdownImpact"/>
            <class package="org.netbeans.modules.nbfx.platform.shell.api.shutdown" name="ShutdownParticipant"/>
            <class package="org.netbeans.modules.nbfx.platform.shell.api.shutdown" name="ShutdownSelection"/>
        </change>
    </changes>
    <htmlcontents>
        <head>
            <title>Change History for the NetBeansFX Shell API</title>
        </head>
        <body>
            <p class="overviewlink"><a href="overview-summary.html">Overview</a></p>
            <h1>Introduction</h1>
            <p>This document lists changes made to the <a href="@TOP@">NetBeansFX Shell API</a>.</p>
            <hr/><standard-changelists module-code-name="org.netbeans.modules.nbfx.platform.shell"/>
            <hr/><p>@FOOTER@</p>
        </body>
    </htmlcontents>
</apichanges>
