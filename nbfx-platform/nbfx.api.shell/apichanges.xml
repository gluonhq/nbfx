<?xml-stylesheet type="text/xsl" href="../../nbbuild/javadoctools/apichanges.xsl"?>
<!DOCTYPE apichanges PUBLIC "-//NetBeans//DTD API changes list 1.0//EN" "../../nbbuild/javadoctools/apichanges.dtd">
<apichanges>
    <apidefs>
        <apidef name="netbeansfx_shell">NetBeansFX Shell API</apidef>
    </apidefs>
    <changes>
        <change id="shell.extraction">
            <api name="netbeansfx_shell"/>
            <summary>The product-facing shell contract, extracted from the shell implementation.</summary>
            <version major="1" minor="0"/>
            <date day="22" month="11" year="2026"/>
            <author login="svenreimers"/>
            <compatibility addition="yes" semantic="compatible"/>
            <description>
                Adds the shell window facade (<code>ShellWindow</code>, <code>WindowManager</code>,
                <code>PaneRole</code>, <code>WindowPaneHost</code>), the chrome and branding contracts,
                the UI-ready hook, the window-environment capabilities and the shutdown contract, plus
                the <code>WindowPaneProvider</code> SPI and the <code>WindowPaneFactory</code> that
                lets a provider obtain a shell-owned <code>WindowPaneHost</code>. The implementation stays in
                <code>nbfx.platform.shell</code>, whose packages are friend-only for the built-in
                product modules.
            </description>
            <class package="org.netbeans.api.nbfx.shell" name="AreaState"/>
            <class package="org.netbeans.api.nbfx.shell" name="DetachedBarsContext"/>
            <class package="org.netbeans.api.nbfx.shell" name="DetachedBarsProvider"/>
            <class package="org.netbeans.api.nbfx.shell" name="NavigatorRevealState"/>
            <class package="org.netbeans.api.nbfx.shell" name="OnUiReady"/>
            <class package="org.netbeans.api.nbfx.shell" name="PaneRole"/>
            <class package="org.netbeans.api.nbfx.shell" name="ProjectSwitcher"/>
            <class package="org.netbeans.api.nbfx.shell" name="ShellBranding"/>
            <class package="org.netbeans.api.nbfx.shell" name="ShellChrome"/>
            <class package="org.netbeans.api.nbfx.shell" name="ShellChromeProfile"/>
            <class package="org.netbeans.api.nbfx.shell" name="ShellChromeProvider"/>
            <class package="org.netbeans.api.nbfx.shell" name="ShellCommandResolver"/>
            <class package="org.netbeans.api.nbfx.shell" name="ShellContext"/>
            <class package="org.netbeans.api.nbfx.shell" name="ShellIconProvider"/>
            <class package="org.netbeans.api.nbfx.shell" name="ShellWindow"/>
            <class package="org.netbeans.api.nbfx.shell" name="ShellWindowProvider"/>
            <class package="org.netbeans.api.nbfx.shell" name="TabHomeResolver"/>
            <class package="org.netbeans.api.nbfx.shell" name="WindowEnvironmentContribution"/>
            <class package="org.netbeans.api.nbfx.shell" name="WindowManager"/>
            <class package="org.netbeans.api.nbfx.shell" name="WindowPaneHost"/>
            <class package="org.netbeans.api.nbfx.shell" name="WindowSink"/>
            <class package="org.netbeans.api.nbfx.shell" name="WindowState"/>
            <class package="org.netbeans.api.nbfx.shell" name="WindowSystem"/>
            <class package="org.netbeans.api.nbfx.shell" name="WindowSystemListener"/>
            <class package="org.netbeans.api.nbfx.shell.shutdown" name="ShutdownCoordinator"/>
            <class package="org.netbeans.api.nbfx.shell.shutdown" name="ShutdownImpact"/>
            <class package="org.netbeans.api.nbfx.shell.shutdown" name="ShutdownParticipant"/>
            <class package="org.netbeans.api.nbfx.shell.shutdown" name="ShutdownSelection"/>
            <class package="org.netbeans.spi.nbfx.shell" name="WindowPane"/>
            <class package="org.netbeans.spi.nbfx.shell" name="WindowPaneContext"/>
            <class package="org.netbeans.spi.nbfx.shell" name="WindowPaneFactory"/>
            <class package="org.netbeans.spi.nbfx.shell" name="WindowPaneProvider"/>
        </change>
        <change id="cjap.shell.regions">
            <api name="netbeansfx_shell"/>
            <summary>Declarative shell-region metadata, registration and discovery.</summary>
            <version major="1" minor="1"/>
            <date day="25" month="11" year="2026"/>
            <author login="svenreimers"/>
            <compatibility addition="yes" semantic="compatible"/>
            <description>
                Adds Node-free <code>ShellRegionId</code>, <code>ShellRegionKind</code>,
                <code>ShellRegionSpec</code>, <code>ShellRegionRegistry</code> and source-retained
                <code>@ShellRegionRegistration</code> declarations for <code>NbFx/ShellRegions</code>.
                Built-ins include <code>DOCK</code>; contribution/renderer lifecycle remains separate.
            </description>
            <class package="org.netbeans.api.nbfx.shell" name="ShellRegionId"/>
            <class package="org.netbeans.api.nbfx.shell" name="ShellRegionKind"/>
            <class package="org.netbeans.api.nbfx.shell" name="ShellRegionSpec"/>
            <class package="org.netbeans.api.nbfx.shell" name="ShellRegionRegistry"/>
            <class package="org.netbeans.api.nbfx.shell" name="ShellRegionRegistration"/>
            <class package="org.netbeans.api.nbfx.shell" name="ShellRegionRegistrations"/>
        </change>
        <change id="cjap.shell.contributions">
            <api name="netbeansfx_shell"/>
            <summary>Per-shell Node contribution registration, discovery and instantiation.</summary>
            <version major="1" minor="2"/>
            <date day="25" month="11" year="2026"/>
            <author login="svenreimers"/>
            <compatibility addition="yes" semantic="compatible"/>
            <description>
                Adds <code>ShellContribution</code>, immutable metadata/entry records, a loader-free
                registry with profile filtering and fresh per-shell instantiation, and
                <code>@ShellContributionRegistration</code>. <code>DOCK</code> remains runtime-owned;
                Node mounting and host lifecycle belong to the shell-frame slice.
            </description>
            <class package="org.netbeans.api.nbfx.shell" name="ShellContribution"/>
            <class package="org.netbeans.api.nbfx.shell" name="ShellContributionSpec"/>
            <class package="org.netbeans.api.nbfx.shell" name="ShellContributionEntry"/>
            <class package="org.netbeans.api.nbfx.shell" name="ShellContributionRegistry"/>
            <class package="org.netbeans.api.nbfx.shell" name="ShellContributionRegistration"/>
            <class package="org.netbeans.api.nbfx.shell" name="ShellContributionRegistrations"/>
        </change>
        <change id="cjap.shell.frame">
            <api name="netbeansfx_shell"/>
            <summary>Shell provider, frame and region-host contracts.</summary>
            <version major="1" minor="3"/>
            <date day="25" month="11" year="2026"/>
            <author login="svenreimers"/>
            <compatibility addition="yes" semantic="compatible"/>
            <description>
                Adds <code>ShellProvider</code>, <code>ShellFrame</code>,
                <code>ShellRegionHost</code>, <code>ShellRegionContext</code> and
                <code>ShellRegionRenderer</code>, plus <code>ShellChromeProfile.id()</code> for
                declarative filtering. <code>ShellFrame.overlays()</code> is intentionally deferred to
                CJAP-6 with <code>OverlayHost</code> in <code>api.content</code>.
            </description>
            <class package="org.netbeans.api.nbfx.shell" name="ShellProvider"/>
            <class package="org.netbeans.api.nbfx.shell" name="ShellFrame"/>
            <class package="org.netbeans.api.nbfx.shell" name="ShellRegionHost"/>
            <class package="org.netbeans.api.nbfx.shell" name="ShellRegionContext"/>
            <class package="org.netbeans.api.nbfx.shell" name="ShellRegionRenderer"/>
            <class package="org.netbeans.api.nbfx.shell" name="ShellChromeProfile"/>
        </change>
        <change id="cjap.shell.profiles">
            <api name="netbeansfx_shell"/>
            <summary>Declarative per-window chrome profile contracts and discovery.</summary>
            <version major="1" minor="4"/>
            <date day="25" month="11" year="2026"/>
            <author login="svenreimers"/>
            <compatibility addition="yes" semantic="compatible"/>
            <description>
                Adds <code>ShellProfileSpec</code>, <code>ShellProfileRegistry</code>,
                <code>@ShellProfileRegistration</code>, <code>ShellProfileHint</code>,
                <code>ChromeProfilePolicy</code>, <code>WindowKind</code>, <code>WindowDecoration</code>
                and <code>WindowOptions</code>. <code>ShellChromeProfile.includeRegion</code> lets a
                profile narrow the regions declared for its id. Neutral profiles and region
                allow-lists land in <code>nbfx.platform.shell</code>; selection and persisted restore
                follow in subsequent C2-6 slices.
            </description>
            <class package="org.netbeans.api.nbfx.shell" name="ChromeProfilePolicy"/>
            <class package="org.netbeans.api.nbfx.shell" name="ShellProfileHint"/>
            <class package="org.netbeans.api.nbfx.shell" name="ShellProfileSpec"/>
            <class package="org.netbeans.api.nbfx.shell" name="ShellProfileRegistry"/>
            <class package="org.netbeans.api.nbfx.shell" name="ShellProfileRegistration"/>
            <class package="org.netbeans.api.nbfx.shell" name="ShellProfileRegistrations"/>
            <class package="org.netbeans.api.nbfx.shell" name="ShellChromeProfile"/>
            <class package="org.netbeans.api.nbfx.shell" name="WindowKind"/>
            <class package="org.netbeans.api.nbfx.shell" name="WindowDecoration"/>
            <class package="org.netbeans.api.nbfx.shell" name="WindowOptions"/>
        </change>
        <change id="cjap.shell.profile.selection">
            <api name="netbeansfx_shell"/>
            <summary>Deterministic chrome-profile selection and product policy services.</summary>
            <version major="1" minor="5"/>
            <date day="25" month="11" year="2026"/>
            <author login="svenreimers"/>
            <compatibility addition="yes" semantic="compatible"/>
            <description>
                Adds <code>ShellProfileResolver</code>, <code>ShellProfileSelection</code> and
                <code>ChromeProfilePolicyProvider</code>. Selection precedence is explicit profile,
                content/group hint, product default, policy fallback and neutral fallback. Explicit
                profile objects remain authoritative; unknown hint/policy ids fall through and
                duplicate declared ids fail. The provider SPI resolves at most one policy matching
                the id named by <code>Product</code>; a present product with no matching provider
                fails rather than silently discarding its declared policy.
                <code>nbfx.platform.shell</code> publishes the
                selected main-window profile before frame creation and applies the effective
                native/undecorated style; ambiguous profile/hint lookups fail and legacy subclass
                chrome keeps its existing path. Persisted profile restore remains
                C2-6c/C3-3 work.
            </description>
            <class package="org.netbeans.api.nbfx.shell" name="ShellProfileResolver"/>
            <class package="org.netbeans.api.nbfx.shell" name="ShellProfileSelection"/>
            <class package="org.netbeans.api.nbfx.shell" name="ChromeProfilePolicyProvider"/>
            <class package="org.netbeans.api.nbfx.shell" name="ChromeProfilePolicy"/>
            <class package="org.netbeans.api.nbfx.shell" name="ShellProfileHint"/>
            <class package="org.netbeans.api.nbfx.shell" name="WindowOptions"/>
        </change>
        <change id="cjap.shell.profile.persistence">
            <api name="netbeansfx_shell"/>
            <summary>Optional chrome profile id in the persisted window state.</summary>
            <version major="1" minor="6"/>
            <date day="25" month="11" year="2026"/>
            <author login="svenreimers"/>
            <compatibility addition="yes" semantic="compatible"/>
            <description>
                Adds the optional <code>profileId</code> component to <code>WindowState</code> and keeps
                the previous constructor source-compatible by delegating with a {@code null} profile.
                The window state store writes the profile only when one is recorded and treats a
                missing or blank key as the pre-profile format. Restore-time profile selection before
                frame creation remains the multi-window slice's work.
            </description>
            <class package="org.netbeans.api.nbfx.shell" name="WindowState"/>
        </change>
        <change id="cjap.shell.window-manager.content-ids">
            <api name="netbeansfx_shell"/>
            <summary>WindowManager operates on content and dock-group identities.</summary>
            <version major="1" minor="7"/>
            <date day="25" month="11" year="2026"/>
            <author login="svenreimers"/>
            <compatibility addition="yes" deletion="yes" modification="yes" binary="incompatible" source="incompatible" semantic="incompatible"/>
            <description>
                Evolves <code>WindowManager</code> from tab/pane operations to stable
                <code>ContentId</code>/<code>DockGroupId</code> operations: groups, primary group,
                groupOf, select, move and attach. Tab- and <code>WindowPaneHost</code>-based methods
                are removed from the public operation surface, matching the CJAP target that public
                docking operations use content/group handles. Dock request/decision/result, float,
                redock and window enumeration follow in later C3 slices.
            </description>
            <class package="org.netbeans.api.nbfx.shell" name="WindowManager"/>
        </change>
        <change id="cjap.shell.dock-request">
            <api name="netbeansfx_shell"/>
            <summary>Dock request, decision and result contracts on WindowManager.</summary>
            <version major="1" minor="8"/>
            <date day="25" month="11" year="2026"/>
            <author login="svenreimers"/>
            <compatibility addition="yes" semantic="compatible"/>
            <description>
                Adds <code>DockRequest</code>, <code>DockDecision</code>, <code>DockResult</code> and
                <code>DockModifier</code>, and exposes <code>canDock</code>/<code>dock</code> on
                <code>WindowManager</code>. The initial implementation accepts group/tab-strip
                placements into existing groups and rejects unsupported placements with a reason key;
                split, float, redock and window enumeration follow in later C3 slices.
            </description>
            <class package="org.netbeans.api.nbfx.shell" name="DockModifier"/>
            <class package="org.netbeans.api.nbfx.shell" name="DockRequest"/>
            <class package="org.netbeans.api.nbfx.shell" name="DockDecision"/>
            <class package="org.netbeans.api.nbfx.shell" name="DockResult"/>
            <class package="org.netbeans.api.nbfx.shell" name="WindowManager"/>
        </change>
        <change id="cjap.shell.dock-policy">
            <api name="netbeansfx_shell"/>
            <summary>DockPolicy SPI consulted by WindowManager docking decisions.</summary>
            <version major="1" minor="9"/>
            <date day="25" month="11" year="2026"/>
            <author login="svenreimers"/>
            <compatibility addition="yes" semantic="compatible"/>
            <description>
                Adds <code>DockPolicy</code>. <code>WindowManager.canDock</code> consults registered
                policies after basic structural validation; the first rejection wins and an allowing
                policy may refine the effective decision.
            </description>
            <class package="org.netbeans.api.nbfx.shell" name="DockPolicy"/>
            <class package="org.netbeans.api.nbfx.shell" name="WindowManager"/>
        </change>
        <change id="cjap.shell.dock-policy-composition">
            <api name="netbeansfx_shell"/>
            <summary>Composable DockPolicy all-of and any-of policies.</summary>
            <version major="1" minor="10"/>
            <date day="26" month="11" year="2026"/>
            <author login="svenreimers"/>
            <compatibility addition="yes" semantic="compatible"/>
            <description>
                Adds <code>DockPolicy.allOf</code> and <code>DockPolicy.anyOf</code>. All-of keeps
                the first rejection and lets allowing policies refine the placement; any-of returns
                the first allowance or, when every policy rejects, the first rejection.
            </description>
            <class package="org.netbeans.api.nbfx.shell" name="DockPolicy"/>
        </change>
        <change id="cjap.shell.dock-request-relative-target">
            <api name="netbeansfx_shell"/>
            <summary>DockRequest carries an optional BEFORE/AFTER target content.</summary>
            <version major="1" minor="11"/>
            <date day="26" month="11" year="2026"/>
            <author login="svenreimers"/>
            <compatibility addition="yes" modification="yes" binary="incompatible" source="compatible" semantic="incompatible"/>
            <description>
                Adds <code>targetContent</code> to <code>DockRequest</code> for relative tab
                placements. A compatibility constructor preserves existing seven-argument source
                call sites. Record equality/string representation and the canonical constructor
                change, so binary compatibility is intentionally not retained.
            </description>
            <class package="org.netbeans.api.nbfx.shell" name="DockRequest"/>
        </change>
        <change id="cjap.shell.dock-window">
            <api name="netbeansfx_shell"/>
            <summary>Public DockWindow contracts and float/redock window operations.</summary>
            <version major="1" minor="12"/>
            <date day="26" month="11" year="2026"/>
            <author login="svenreimers"/>
            <compatibility addition="yes" modification="yes" binary="incompatible" source="incompatible" semantic="incompatible"/>
            <description>
                Adds <code>WindowId</code>, <code>WindowContentState</code>,
                <code>WindowContent</code> and <code>DockWindow</code>, plus
                <code>WindowManager.floatContent</code>, <code>floatGroup</code>,
                <code>redock</code> and <code>windows</code>. Floating windows preserve pane/content
                identity and expose layout, lookup, opaque content state and geometry snapshots.
                Main/custom window enumeration remains for the multi-window slice.
            </description>
            <class package="org.netbeans.api.nbfx.shell" name="WindowId"/>
            <class package="org.netbeans.api.nbfx.shell" name="WindowContentState"/>
            <class package="org.netbeans.api.nbfx.shell" name="WindowContent"/>
            <class package="org.netbeans.api.nbfx.shell" name="DockWindow"/>
            <class package="org.netbeans.api.nbfx.shell" name="WindowManager"/>
        </change>
        <change id="cjap.shell.custom-window">
            <api name="netbeansfx_shell"/>
            <summary>Product-owned custom windows through WindowManager.</summary>
            <version major="1" minor="13"/>
            <date day="26" month="11" year="2026"/>
            <author login="svenreimers"/>
            <compatibility addition="yes" modification="yes" binary="incompatible" source="incompatible" semantic="incompatible"/>
            <description>
                Adds <code>WindowManager.createCustomWindow</code>. Custom windows host a product
                <code>WindowContent</code>, have no <code>LayoutNode</code>, participate in
                <code>windows()</code>, and release content host resources on close. The interface
                expansion is intentionally incompatible for external <code>WindowManager</code>
                implementers.
            </description>
            <class package="org.netbeans.api.nbfx.shell" name="WindowManager"/>
        </change>
    </changes>
