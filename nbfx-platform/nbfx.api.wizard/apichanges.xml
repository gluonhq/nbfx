<?xml-stylesheet type="text/xml" href="../../nbbuild/javadoctools/apichanges.xsl"?>
<!DOCTYPE apichanges PUBLIC "-//NetBeans//DTD API changes list 1.0//EN" "../../nbbuild/javadoctools/apichanges.dtd">
<apichanges>
    <apidefs>
        <apidef name="netbeansfx_wizard">NetBeansFX Wizard API</apidef>
    </apidefs>
    <changes>
        <change id="wizard.contract">
            <api name="netbeansfx_wizard"/>
            <summary>The JavaFX wizard SPI and its discovery contract.</summary>
            <version major="1" minor="1"/>
            <date day="20" month="11" year="2026"/>
            <author login="svenreimers"/>
            <compatibility addition="yes" semantic="compatible"/>
            <description>
                Moves <code>Wizard</code>, <code>WizardPanel</code> (from
                <code>WizardPanelHost</code>), <code>WizardEntry</code> and <code>WizardRegistry</code>
                from <code>platform.wizard</code> to this API module. The processor now validates
                that the annotated class implements <code>Wizard</code>; the registry reads the
                class-based layer entries through <code>LayerInstances</code>.
            </description>
            <class package="org.netbeans.api.nbfx.wizard" name="Wizard"/>
            <class package="org.netbeans.api.nbfx.wizard" name="WizardPanel"/>
            <class package="org.netbeans.api.nbfx.wizard" name="WizardEntry"/>
            <class package="org.netbeans.api.nbfx.wizard" name="WizardRegistry"/>
            <class package="org.netbeans.api.nbfx.wizard" name="WizardDisplayer"/>
        </change>
    </changes>
    <htmlcontents>
        <head>
            <title>Change History for the NetBeansFX Wizard API</title>
        </head>
        <body>
            <p class="overviewlink"><a href="overview-summary.html">Overview</a></p>
            <h1>Introduction</h1>
            <p>This document lists changes made to the <a href="@TOP@">NetBeansFX Wizard API</a>.</p>
            <hr/><standard-changelists module-code-name="org.netbeans.modules.nbfx.api.wizard"/>
            <hr/><p>@FOOTER@</p>
        </body>
    </htmlcontents>
</apichanges>
