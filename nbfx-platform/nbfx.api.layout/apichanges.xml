<?xml-stylesheet type="text/xsl" href="../../nbbuild/javadoctools/apichanges.xsl"?>
<!DOCTYPE apichanges PUBLIC "-//NetBeans//DTD API changes list 1.0//EN" "../../nbbuild/javadoctools/apichanges.dtd">
<apichanges>
    <apidefs>
        <apidef name="netbeansfx_layout">NetBeansFX Layout API</apidef>
    </apidefs>
    <changes>
        <change id="initial.devel">
            <api name="netbeansfx_layout"/>
            <summary>Initial devel module skeleton.</summary>
            <version major="1" minor="0"/>
            <date day="24" month="11" year="2026"/>
            <author login="svenreimers"/>
            <compatibility addition="yes" semantic="compatible"/>
            <description>Creates the module and its public package with stable layout ids,
            neutral area kinds, immutable area/group/tree values, a validated builder, secure,
            diagnostic XML authoring with caller-resolved includes, declarative layout registration
            and discovery, and standalone logical-area and physical dock-group metadata registration.</description>
            <class package="org.netbeans.api.nbfx.layout" name="PaneRole"/>
            <class package="org.netbeans.api.nbfx.layout" name="ViewAreaKind"/>
            <class package="org.netbeans.api.nbfx.layout" name="DockGroupId"/>
            <class package="org.netbeans.api.nbfx.layout" name="SlotId"/>
            <class package="org.netbeans.api.nbfx.layout" name="PresentationId"/>
            <class package="org.netbeans.api.nbfx.layout" name="DockLocation"/>
            <class package="org.netbeans.api.nbfx.layout" name="PaneKind"/>
            <class package="org.netbeans.api.nbfx.layout" name="ContentCapacity"/>
            <class package="org.netbeans.api.nbfx.layout" name="GroupLifetime"/>
            <class package="org.netbeans.api.nbfx.layout" name="SplitOrientation"/>
            <class package="org.netbeans.api.nbfx.layout" name="DockSide"/>
            <class package="org.netbeans.api.nbfx.layout" name="ViewAreaCapability"/>
            <class package="org.netbeans.api.nbfx.layout" name="ViewAreaVisibility"/>
            <class package="org.netbeans.api.nbfx.layout" name="AreaStyle"/>
            <class package="org.netbeans.api.nbfx.layout" name="ViewArea"/>
            <class package="org.netbeans.api.nbfx.layout" name="DockGroupSpec"/>
            <class package="org.netbeans.api.nbfx.layout" name="LayoutNode"/>
            <class package="org.netbeans.api.nbfx.layout" name="LayoutBuilder"/>
            <class package="org.netbeans.api.nbfx.layout" name="LayoutXml"/>
            <class package="org.netbeans.api.nbfx.layout" name="LayoutRegistration"/>
            <class package="org.netbeans.api.nbfx.layout" name="LayoutRegistrations"/>
            <class package="org.netbeans.api.nbfx.layout" name="LayoutRegistry"/>
            <class package="org.netbeans.api.nbfx.layout" name="ViewAreaRegistration"/>
            <class package="org.netbeans.api.nbfx.layout" name="ViewAreaRegistrations"/>
            <class package="org.netbeans.api.nbfx.layout" name="DockGroupRegistration"/>
            <class package="org.netbeans.api.nbfx.layout" name="DockGroupRegistrations"/>
            <class package="org.netbeans.api.nbfx.layout" name="LayoutSpec"/>
            <class package="org.netbeans.api.nbfx.layout" name="EmptyAreaPolicy"/>
        </change>
    </changes>
    <htmlcontents>
        <head><title>Change History for the NetBeansFX Layout API</title></head>
        <body>
            <p class="overviewlink"><a href="overview-summary.html">Overview</a></p>
            <h1>Introduction</h1>
            <p>This document lists changes made to the <a href="@TOP@">NetBeansFX Layout API</a>.</p>
            <hr/><standard-changelists module-code-name="org.netbeans.modules.nbfx.api.layout"/>
            <hr/><p>@FOOTER@</p>
        </body>
    </htmlcontents>
