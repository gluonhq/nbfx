<?xml-stylesheet type="text/xml" href="../../nbbuild/javadoctools/apichanges.xsl"?>
<!DOCTYPE apichanges PUBLIC "-//NetBeans//DTD API changes list 1.0//EN" "../../nbbuild/javadoctools/apichanges.dtd">
<apichanges>
    <apidefs>
        <apidef name="netbeansfx_views">NetBeansFX View API</apidef>
    </apidefs>
    <changes>
        <change id="view.placement.types">
            <api name="netbeansfx_views"/>
            <summary>One view placement type and package.</summary>
            <version major="1" minor="4"/>
            <date day="4" month="11" year="2026"/>
            <author login="sven"/>
            <compatibility addition="no" modification="yes" removal="yes" semantic="incompatible"/>
            <description>
                Moves <code>ViewArea</code> and <code>DockLocation</code> into
                <code>org.netbeans.api.nbfx.views</code>, removes the duplicate
                <code>ViewLocation</code> enum, and makes <code>ViewRegistration.location()</code>
                use <code>DockLocation</code>. Detached windows remain a runtime action rather than
                a registered location. <code>ViewSpec.location()</code> is derived from its area.
            </description>
            <class package="org.netbeans.api.nbfx.views" name="ViewArea"/>
            <class package="org.netbeans.api.nbfx.views" name="DockLocation"/>
            <class package="org.netbeans.api.nbfx.views" name="ViewRegistration"/>
        </change>
        <change id="navigator.revealer.index">
            <api name="netbeansfx_views"/>
            <summary>Reveal in a specific navigator.</summary>
            <version major="1" minor="5"/>
            <date day="4" month="11" year="2026"/>
            <author login="sven"/>
            <compatibility addition="yes" semantic="compatible"/>
            <description>
                Adds <code>NavigatorRevealer.reveal(FileObject, int)</code> so callers can select
                the Projects or Files navigator explicitly while the single-argument reveal remains
                the compatibility default.
            </description>
            <class package="org.netbeans.api.nbfx.view" name="NavigatorRevealer"/>
        </change>
        <change id="open.view.contract">
            <api name="netbeansfx_views"/>
            <summary>Open-view metadata, kinds and activation.</summary>
            <version major="1" minor="6"/>
            <date day="9" month="11" year="2026"/>
            <author login="sven"/>
            <compatibility addition="yes" semantic="compatible"/>
            <description>
                Adds <code>ViewKind</code>, the metadata-only <code>ViewInfo</code> record, and
                default <code>ViewManager</code> methods to list open views, report the active view,
                activate a view by id and register open-view listeners. <code>ViewRegistration</code>
                gains a <code>kind</code> attribute with a <code>tool</code> default.
            </description>
            <class package="org.netbeans.api.nbfx.view" name="ViewInfo"/>
            <class package="org.netbeans.api.nbfx.view" name="ViewManager"/>
            <class package="org.netbeans.api.nbfx.views" name="ViewKind"/>
            <class package="org.netbeans.api.nbfx.views" name="ViewRegistration"/>
        </change>
    </changes>
    <htmlcontents>
        <head>
            <title>Change History for the NetBeansFX View API</title>
        </head>
        <body>
            <p class="overviewlink"><a href="overview-summary.html">Overview</a></p>
            <h1>Introduction</h1>
            <p>This document lists changes made to the <a href="@TOP@">NetBeansFX View API</a>.</p>
            <hr/><standard-changelists module-code-name="org.netbeans.modules.nbfx.api.views"/>
            <hr/><p>@FOOTER@</p>
        </body>
    </htmlcontents>
</apichanges>
