<?xml-stylesheet type="text/xsl" href="../../nbbuild/javadoctools/apichanges.xsl"?>
<!DOCTYPE apichanges PUBLIC "-//NetBeans//DTD API changes list 1.0//EN" "../../nbbuild/javadoctools/apichanges.dtd">
<apichanges>
    <apidefs>
        <apidef name="netbeansfx_product">NetBeansFX Product API</apidef>
    </apidefs>
    <changes>
        <change id="initial.devel">
            <api name="netbeansfx_product"/>
            <summary>Initial immutable product metadata and exactly-one provider discovery.</summary>
            <version major="1" minor="0"/>
            <date day="25" month="11" year="2026"/>
            <author login="svenreimers"/>
            <compatibility addition="yes" semantic="compatible"/>
            <description>Creates the model-tier product contract for identity, icons, style, About,
                desktop associations, default policy ids and duplicate-provider-safe discovery.</description>
            <class package="org.netbeans.api.nbfx.product" name="ProductProvider"/>
            <class package="org.netbeans.api.nbfx.product" name="Product"/>
            <class package="org.netbeans.api.nbfx.product" name="ProductIdentity"/>
            <class package="org.netbeans.api.nbfx.product" name="ProductIcons"/>
            <class package="org.netbeans.api.nbfx.product" name="ProductStyle"/>
            <class package="org.netbeans.api.nbfx.product" name="AboutInfo"/>
            <class package="org.netbeans.api.nbfx.product" name="DesktopAssociation"/>
        </change>
    </changes>
    <htmlcontents>
        <head><title>Change History for the NetBeansFX Product API</title></head>
        <body>
            <p class="overviewlink"><a href="overview-summary.html">Overview</a></p>
            <h1>Introduction</h1>
            <p>This document lists changes made to the <a href="@TOP@">NetBeansFX Product API</a>.</p>
            <hr/><standard-changelists module-code-name="org.netbeans.modules.nbfx.api.product"/>
            <hr/><p>@FOOTER@</p>
        </body>
    </htmlcontents>
</apichanges>
