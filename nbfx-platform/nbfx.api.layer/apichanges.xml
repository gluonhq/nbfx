<?xml-stylesheet type="text/xml" href="../../nbbuild/javadoctools/apichanges.xsl"?>
<!DOCTYPE apichanges PUBLIC "-//NetBeans//DTD API changes list 1.0//EN" "../../nbbuild/javadoctools/apichanges.dtd">
<apichanges>
    <apidefs>
        <apidef name="netbeansfx_layer">NetBeansFX Layer API</apidef>
    </apidefs>
    <changes>
        <change id="view.areas.layouts.paths">
            <api name="netbeansfx_layer"/>
            <summary>Layer paths for view areas and window layouts.</summary>
            <version major="1" minor="1"/>
            <date day="6" month="11" year="2026"/>
            <author login="sven"/>
            <compatibility addition="yes" semantic="compatible"/>
            <description>
                Adds <code>LayerPaths.VIEW_AREAS</code> and <code>LayerPaths.WINDOW_LAYOUTS</code>.
            </description>
            <class package="org.netbeans.api.nbfx.layer" name="LayerPaths"/>
        </change>
        <change id="window.panes.path">
            <api name="netbeansfx_layer"/>
            <summary>Layer path for permanent window panes.</summary>
            <version major="1" minor="2"/>
            <date day="6" month="11" year="2026"/>
            <author login="sven"/>
            <compatibility addition="yes" semantic="compatible"/>
            <description>
                Adds <code>LayerPaths.WINDOW_PANES</code>.
            </description>
            <class package="org.netbeans.api.nbfx.layer" name="LayerPaths"/>
        </change>
        <change id="theme.tokens.path">
            <api name="netbeansfx_layer"/>
            <summary>Layer path for theme token defaults.</summary>
            <version major="1" minor="3"/>
            <date day="6" month="11" year="2026"/>
            <author login="sven"/>
            <compatibility addition="yes" semantic="compatible"/>
            <description>
                Adds <code>LayerPaths.THEME_TOKENS</code>.
            </description>
            <class package="org.netbeans.api.nbfx.layer" name="LayerPaths"/>
        </change>
    </changes>
    <htmlcontents>
        <head>
            <title>Change History for the NetBeansFX Layer API</title>
        </head>
        <body>
            <p class="overviewlink"><a href="overview-summary.html">Overview</a></p>
            <h1>Introduction</h1>
            <p>This document lists changes made to the <a href="@TOP@">NetBeansFX Layer API</a>.</p>
            <hr/><standard-changelists module-code-name="org.netbeans.modules.nbfx.api.layer"/>
            <hr/><p>@FOOTER@</p>
        </body>
    </htmlcontents>
</apichanges>
