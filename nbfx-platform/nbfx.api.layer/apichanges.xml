<?xml-stylesheet type="text/xml" href="../../nbbuild/javadoctools/apichanges.xsl"?>
<!DOCTYPE apichanges PUBLIC "-//NetBeans//DTD API changes list 1.0//EN" "../../nbbuild/javadoctools/apichanges.dtd">
<apichanges>
    <apidefs>
        <apidef name="netbeansfx_layer">NetBeansFX Layer API</apidef>
    </apidefs>
    <changes>
        <change id="view.areas.layouts.paths">
            <api name="netbeansfx_layer"/>
            <summary>Layer paths for view areas and window layouts.</summary>
            <version major="1" minor="1"/>
            <date day="6" month="11" year="2026"/>
            <author login="sven"/>
            <compatibility addition="yes" semantic="compatible"/>
            <description>
                Adds <code>LayerPaths.VIEW_AREAS</code> and <code>LayerPaths.WINDOW_LAYOUTS</code>.
            </description>
            <class package="org.netbeans.api.nbfx.layer" name="LayerPaths"/>
        </change>
        <change id="window.panes.path">
            <api name="netbeansfx_layer"/>
            <summary>Layer path for permanent window panes.</summary>
            <version major="1" minor="2"/>
            <date day="6" month="11" year="2026"/>
            <author login="sven"/>
            <compatibility addition="yes" semantic="compatible"/>
            <description>
                Adds <code>LayerPaths.WINDOW_PANES</code>.
            </description>
            <class package="org.netbeans.api.nbfx.layer" name="LayerPaths"/>
        </change>
        <change id="theme.tokens.path">
            <api name="netbeansfx_layer"/>
            <summary>Layer path for theme token defaults.</summary>
            <version major="1" minor="3"/>
            <date day="6" month="11" year="2026"/>
            <author login="sven"/>
            <compatibility addition="yes" semantic="compatible"/>
            <description>
                Adds <code>LayerPaths.THEME_TOKENS</code>.
            </description>
            <class package="org.netbeans.api.nbfx.layer" name="LayerPaths"/>
        </change>
        <change id="layer.instances">
            <api name="netbeansfx_layer"/>
            <summary>Node-free layer instance reader.</summary>
            <version major="1" minor="4"/>
            <date day="20" month="11" year="2026"/>
            <author login="svenreimers"/>
            <compatibility addition="yes" semantic="compatible"/>
            <description>
                Adds <code>LayerInstances</code> and <code>LayerEntry</code> to read the
                class-based <code>.instance</code> entries the nbfx annotation processors write, with
                their attributes and layer order, without <code>DataObject</code> or
                <code>InstanceCookie</code>.
            </description>
            <class package="org.netbeans.api.nbfx.layer" name="LayerInstances"/>
            <class package="org.netbeans.api.nbfx.layer" name="LayerEntry"/>
        </change>
        <change id="layer.registrations">
            <api name="netbeansfx_layer"/>
            <summary>Read class-based layer entries without creating them.</summary>
            <version major="1" minor="5"/>
            <date day="21" month="11" year="2026"/>
            <author login="svenreimers"/>
            <compatibility addition="yes" semantic="compatible"/>
            <description>
                Adds <code>LayerInstances.registrations</code> and <code>LayerRegistration</code> to
                read the declared class and attributes before creating the instance, and
                <code>LayerInstances.instantiate</code> to create one registration on demand.
                <code>LayerInstances.load</code> keeps the eager behavior.
            </description>
            <class package="org.netbeans.api.nbfx.layer" name="LayerInstances"/>
            <class package="org.netbeans.api.nbfx.layer" name="LayerRegistration"/>
        </change>
        <change id="cjap.layouts.path">
            <api name="netbeansfx_layer"/>
            <summary>Layer path for CJAP product layouts.</summary>
            <version major="1" minor="6"/>
            <date day="25" month="11" year="2026"/>
            <author login="svenreimers"/>
            <compatibility addition="yes" semantic="compatible"/>
            <description>
                Adds <code>LayerPaths.LAYOUTS</code> for declarative CJAP layout XML resources.
            </description>
            <class package="org.netbeans.api.nbfx.layer" name="LayerPaths"/>
        </change>
        <change id="cjap.layout.areas.path">
            <api name="netbeansfx_layer"/>
            <summary>Layer path for CJAP logical layout areas.</summary>
            <version major="1" minor="7"/>
            <date day="25" month="11" year="2026"/>
            <author login="svenreimers"/>
            <compatibility addition="yes" semantic="compatible"/>
            <description>
                Adds <code>LayerPaths.LAYOUT_AREAS</code> for declarative CJAP area metadata.
            </description>
            <class package="org.netbeans.api.nbfx.layer" name="LayerPaths"/>
        </change>
        <change id="cjap.dock.groups.path">
            <api name="netbeansfx_layer"/>
            <summary>Layer path for CJAP physical dock groups.</summary>
            <version major="1" minor="8"/>
            <date day="25" month="11" year="2026"/>
            <author login="svenreimers"/>
            <compatibility addition="yes" semantic="compatible"/>
            <description>
                Adds <code>LayerPaths.DOCK_GROUPS</code> for declarative CJAP dock-group metadata.
            </description>
            <class package="org.netbeans.api.nbfx.layer" name="LayerPaths"/>
        </change>
        <change id="cjap.shell.regions.path">
            <api name="netbeansfx_layer"/>
            <summary>Layer path for declarative shell regions.</summary>
            <version major="1" minor="9"/>
            <date day="25" month="11" year="2026"/>
            <author login="svenreimers"/>
            <compatibility addition="yes" semantic="compatible"/>
            <description>
                Adds <code>LayerPaths.SHELL_REGIONS</code> for CJAP shell chrome metadata and
                contribution/action children.
            </description>
            <class package="org.netbeans.api.nbfx.layer" name="LayerPaths"/>
        </change>
    </changes>
    <htmlcontents>
        <head>
            <title>Change History for the NetBeansFX Layer API</title>
        </head>
        <body>
            <p class="overviewlink"><a href="overview-summary.html">Overview</a></p>
            <h1>Introduction</h1>
            <p>This document lists changes made to the <a href="@TOP@">NetBeansFX Layer API</a>.</p>
            <hr/><standard-changelists module-code-name="org.netbeans.modules.nbfx.api.layer"/>
            <hr/><p>@FOOTER@</p>
        </body>
    </htmlcontents>
</apichanges>
