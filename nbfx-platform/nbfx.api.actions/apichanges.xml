<?xml-stylesheet type="text/xsl" href="../../nbbuild/javadoctools/apichanges.xsl"?>
<!DOCTYPE apichanges PUBLIC "-//NetBeans//DTD API changes list 1.0//EN" "../../nbbuild/javadoctools/apichanges.dtd">
<apichanges>
    <apidefs>
        <apidef name="netbeansfx_actions">NetBeansFX Actions API</apidef>
    </apidefs>
    <changes>
        <change id="action.command.registration">
            <api name="netbeansfx_actions"/>
            <summary>Require Command registrations and add context resolution.</summary>
            <version major="2" minor="0"/>
            <date day="25" month="11" year="2026"/>
            <author login="svenreimers"/>
            <compatibility addition="yes" semantic="incompatible"/>
            <description>
                <code>@ActionRegistration</code> now targets classes only and requires a public,
                concrete, no-argument <code>Command</code> implementation. Method and Runnable-only
                registrations are rejected. Adds <code>Command.forContext(Lookup)</code> and
                <code>ActionRegistry.resolve(id, Lookup)</code>. The platform registry loads canonical
                command instances from <code>NbFx/Actions</code> through <code>api.layer</code>, with
                provider fallback retained during migration. Layer-owned ids also take precedence in
                the legacy window-scoped resolution path and follows its observable active document.
            </description>
            <class package="org.netbeans.api.nbfx.actions" name="ActionRegistration"/>
            <class package="org.netbeans.api.nbfx.actions" name="Command"/>
            <class package="org.netbeans.api.nbfx.actions" name="ActionRegistry"/>
        </change>
    </changes>
    <htmlcontents>
        <head><title>Change History for the NetBeansFX Actions API</title></head>
        <body>
            <p class="overviewlink"><a href="overview-summary.html">Overview</a></p>
            <h1>Introduction</h1>
            <p>This document lists changes made to the <a href="@TOP@">NetBeansFX Actions API</a>.</p>
            <hr/><standard-changelists module-code-name="org.netbeans.modules.nbfx.api.actions"/>
            <hr/><p>@FOOTER@</p>
        </body>
    </htmlcontents>
</apichanges>
