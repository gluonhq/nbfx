<?xml-stylesheet type="text/xsl" href="../../nbbuild/javadoctools/apichanges.xsl"?>
<!DOCTYPE apichanges PUBLIC "-//NetBeans//DTD API changes list 1.0//EN" "../../nbbuild/javadoctools/apichanges.dtd">
<apichanges>
    <apidefs>
        <apidef name="netbeansfx_status">NetBeansFX Status API</apidef>
    </apidefs>
    <changes>
        <change id="status.contract">
            <api name="netbeansfx_status"/>
            <summary>The JavaFX status element SPI and its metadata-only discovery contract.</summary>
            <version major="1" minor="2"/>
            <date day="21" month="11" year="2026"/>
            <author login="svenreimers"/>
            <compatibility addition="yes" semantic="compatible"/>
            <description>
                Adds <code>StatusElement</code> (moved from the T0 status bar renderer),
                <code>StatusElementSpec</code> and <code>StatusElementRegistry</code>. The registry
                reads the class-based layer entries through <code>LayerInstances</code>; the
                processor validates that the annotated class implements <code>StatusElement</code>.
            </description>
            <class package="org.netbeans.api.nbfx.status" name="StatusElement"/>
            <class package="org.netbeans.api.nbfx.status" name="StatusElementSpec"/>
            <class package="org.netbeans.api.nbfx.status" name="StatusElementRegistry"/>
        </change>
    </changes>
    <htmlcontents>
        <head>
            <title>Change History for the NetBeansFX Status API</title>
        </head>
        <body>
            <p class="overviewlink"><a href="overview-summary.html">Overview</a></p>
            <h1>Introduction</h1>
            <p>This document lists changes made to the <a href="@TOP@">NetBeansFX Status API</a>.</p>
            <hr/><standard-changelists module-code-name="org.netbeans.modules.nbfx.api.status"/>
            <hr/><p>@FOOTER@</p>
        </body>
    </htmlcontents>
</apichanges>
