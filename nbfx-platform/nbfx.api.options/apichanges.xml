<?xml-stylesheet type="text/xml" href="../../nbbuild/javadoctools/apichanges.xsl"?>
<!DOCTYPE apichanges PUBLIC "-//NetBeans//DTD API changes list 1.0//EN" "../../nbbuild/javadoctools/apichanges.dtd">
<apichanges>
    <apidefs>
        <apidef name="netbeansfx_options">NetBeansFX Options API</apidef>
    </apidefs>
    <changes>
        <change id="options.panel.contract">
            <api name="netbeansfx_options"/>
            <summary>Published options panel and displayer contract.</summary>
            <version major="1" minor="1"/>
            <date day="12" month="11" year="2026"/>
            <author login="sven"/>
            <compatibility addition="yes" semantic="compatible"/>
            <description>
                Adds <code>OptionsPanelController</code>, the interface a module implements and
                registers with <code>@OptionsRegistration</code>/<code>@OptionsSubRegistration</code>,
                and <code>OptionsDisplayer</code>, the platform service that opens the options
                window. The generated layer entry now carries the controller type, and the
                registration processor rejects a class that does not implement it.
            </description>
            <class package="org.netbeans.api.nbfx.options" name="OptionsPanelController"/>
            <class package="org.netbeans.api.nbfx.options" name="OptionsDisplayer"/>
        </change>
    </changes>
    <htmlcontents>
        <head>
            <title>Change History for the NetBeansFX Options API</title>
        </head>
        <body>
            <p class="overviewlink"><a href="overview-summary.html">Overview</a></p>
            <h1>Introduction</h1>
            <p>This document lists changes made to the <a href="@TOP@">NetBeansFX Options API</a>.</p>
            <hr/><standard-changelists module-code-name="org.netbeans.modules.nbfx.api.options"/>
            <hr/><p>@FOOTER@</p>
        </body>
    </htmlcontents>
</apichanges>
