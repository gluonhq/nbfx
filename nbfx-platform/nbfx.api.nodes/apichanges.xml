<?xml-stylesheet type="text/xml" href="../../nbbuild/javadoctools/apichanges.xsl"?>
<!DOCTYPE apichanges PUBLIC "-//NetBeans//DTD API changes list 1.0//EN" "../../nbbuild/javadoctools/apichanges.dtd">
<apichanges>
    <apidefs>
        <apidef name="netbeansfx_nodes">NetBeansFX Nodes API</apidef>
    </apidefs>
    <changes>
        <change id="nodes.property-contract">
            <api name="netbeansfx_nodes"/>
            <summary>The toolkit-free property model for the property sheet.</summary>
            <version major="1" minor="0"/>
            <date day="18" month="11" year="2026"/>
            <author login="svenreimers"/>
            <compatibility addition="yes" semantic="compatible"/>
            <description>
                Adds <code>PropertyModel</code>, <code>PropertySetModel</code>,
                <code>PropertiesProvider</code>, <code>PropertyListener</code>,
                <code>PropertySubscription</code>, <code>SimplePropertyModel</code> and
                <code>SimplePropertySetModel</code> as the M-tier property model behind the
                property sheet. The model has no JavaFX types; the FX-facing
                <code>ObservablePropertyModel</code> lives in <code>api.property</code>.
            </description>
            <class package="org.netbeans.api.nbfx.nodes" name="PropertyModel"/>
            <class package="org.netbeans.api.nbfx.nodes" name="PropertySetModel"/>
            <class package="org.netbeans.api.nbfx.nodes" name="PropertiesProvider"/>
            <class package="org.netbeans.api.nbfx.nodes" name="PropertyListener"/>
            <class package="org.netbeans.api.nbfx.nodes" name="PropertySubscription"/>
            <class package="org.netbeans.api.nbfx.nodes" name="SimplePropertyModel"/>
            <class package="org.netbeans.api.nbfx.nodes" name="SimplePropertySetModel"/>
        </change>
    </changes>
    <htmlcontents>
        <head>
            <title>Change History for the NetBeansFX Nodes API</title>
        </head>
        <body>
            <p class="overviewlink"><a href="overview-summary.html">Overview</a></p>
            <h1>Introduction</h1>
            <p>This document lists changes made to the <a href="@TOP@">NetBeansFX Nodes API</a>.</p>
            <hr/><standard-changelists module-code-name="org.netbeans.modules.nbfx.api.nodes"/>
            <hr/><p>@FOOTER@</p>
        </body>
    </htmlcontents>
</apichanges>
